# ==========================================
# Solidarities Link (SoLi)
# Environment variables for Docker Compose
# ==========================================

# --- PostgreSQL ---
POSTGRES_DB=soli_db
POSTGRES_USER=soli
POSTGRES_PASSWORD=soli_password
POSTGRES_PORT=5433

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8180

# --- Backend (Quarkus) ---
BACKEND_PORT=8080
QUARKUS_PROFILE=prod
QUARKUS_OIDC_CLIENT_ID=soli-backend
QUARKUS_OIDC_CREDENTIALS_SECRET=soli-backend-secret

# --- Frontend (React Vite) ---
FRONTEND_PORT=5173
VITE_KEYCLOAK_URL=http://localhost:8180/realms/soli
VITE_KEYCLOAK_CLIENT_ID=soli-frontend
